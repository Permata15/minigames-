# Salin file ini menjadi .env lalu isi API key Anda dari https://console.anthropic.com
ANTHROPIC_API_KEY=isi-api-key-anda-di-sini

# Model: claude-opus-5-5 (paling pintar) atau claude-haiku-5-5 (jauh lebih murah)
CLAUDE_MODEL=claude-opus-5-5

# Kepribadian chatbot Anda
SYSTEM_PROMPT=Kamu adalah asisten yang ramah dan membantu. Jawab dalam Bahasa Indonesia yang santai dan jelas.

PORT=3000
